# ==============================================================================
# CCTV AI - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Hướng dẫn: Sao chép file này thành '.env' và điền các thông tin tương ứng.
# ==============================================================================

# --- 1. Cấu hình Telegram Bot Cảnh Báo ---
# Lấy từ @BotFather trên Telegram (ví dụ: 1234567890:ABCdefGhIJKlmNoPQRstuVWxYz)
TELEGRAM_BOT_TOKEN=

# Chat ID nhận thông báo (Có thể để trống để Web UI tự động phát hiện, hoặc lấy từ @userinfobot)
TELEGRAM_CHAT_ID=

# Username của Bot (tùy chọn)
TELEGRAM_BOT_USERNAME=cameraAIyolo_bot

# Danh sách sự kiện gửi cảnh báo (cách nhau bởi dấu phẩy)
TELEGRAM_EVENTS=RÚT TIỀN,BỎ TIỀN,CHẠM RỔ

# Thời gian giãn cách tối thiểu giữa 2 cảnh báo liên tiếp (giây)
TELEGRAM_COOLDOWN_SECONDS=3.0

# --- 2. Cấu hình Camera / Stream ---
# 0 cho Webcam mặc định, 1 hoặc 2 cho Webcam USB ngoài, hoặc đường dẫn RTSP (rtsp://admin:pass@ip:port/stream)
DEFAULT_CAMERA_SOURCE=0

# --- 3. Cấu hình Cổng Mạng (Ports) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
